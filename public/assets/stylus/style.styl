@import "fonts.styl"
@import "vars.styl"

// Общие 
*
	margin 0
	padding 0
	box-sizing border-box
	font-family 'Mazzard H', sans-serif
	color $w
	line-height 1.16
	outline none !important
	&::selection
		background-color $accent
	
img
	max-width 100%
	width 100%
	vertical-align bottom

body
	width 100%
	min-width 320px
	background linear-gradient(239deg, #1B2330 -95.96%, #111720 67.43%), $bgc

span, p, a, input, button, li
	font-size inherit

span, p, a, li
	font-weight inherit
	font-family inherit
	letter-spacing inherit
	line-height inherit
	color inherit
	text-align inherit

input, textarea
	border unset

button
	cursor pointer
	border none
	background-color unset
	white-space nowrap

a
	text-decoration none

html
	--content-width 1520px
	--header-height 176px
	&::-webkit-scrollbar
		width 10px
		background-color darken($bgc,10%)
		&-thumb
			width 10px
			background-color $accent
			&:hover
				background-color darken($accent,10%)
	
.wrapper
	width 100%
	overflow-x hidden
	
.content
	width var(--content-width)
	max-width calc(100% - 160px)
	margin 0 auto
	position relative

.section-category
	padding 12px 25px 12px 15px
	background-color #1A2431
	display inline-flex
	align-items center
	border-radius 100px
	white-space nowrap
	& +
		.section-caption,
		.section-caption-container
			margin-top 25px
	&__
		&icon
			width 36px
			height 36px
			border-radius 50%
			background linear-gradient(166.41deg, $accent 9.73%, $secondary 102.08%)
			display flex
			align-items center
			justify-content center
			margin-right 15px
			img
				width 60%
				height 60%
				object-fit contain
				object-position center
		&text
			font-size 16px
			font-weight 500

.section-caption
	font-size 55px
	font-weight 500
	letter-spacing -0.01em
	& + .section-subcaption
		margin-top 15px
	&__
		&icon
			display inline-flex
			align-items center
			justify-content center
			border-radius 50%
			width .8em
			height .8em
			background linear-gradient(166.41deg, #AD57FF 9.73%, #8A56FF 102.08%)
			vertical-align middle
			span
				display block
				width 55%
				height 55%
				background-image url('../img/icon_lightning.svg')
				background-size contain
				background-repeat no-repeat

.section-caption-container
	display flex
	align-items center
	justify-content space-between

.section-subcaption
	font-size 22px
	line-height 1.44
	color rgba($w, .54)
	display flex
	align-items center
	font-family $fmm
	.social-btn
		margin-left 30px

.btn
	transition 0.3s background-color
	font-weight 600
	display flex
	align-items center
	justify-content center
	border-radius 100px
	background-color #141A25
	border 1px solid #222C3D
	&[disabled]
		opacity 0.5
		pointer-events none
	&:hover
		background-color #222C3D
	&__
		&icon
			padding-right 7px
			border-right 1px solid rgba($w, .18)
			margin-right 15px
			img
				width 23px
				height 23px
				object-fit contain
				object-position center
	&-accent
		background-color $accent
		&:hover
			background-color darken($accent, 10%)

.types
	padding 4px 7px 4px 25px
	border-radius 4px
	background-color rgba(#8AF59B,.09)
	display inline-block
	font-weight 500
	font-size 14px
	color #8AF59B
	background-image url('../img/icon_7.svg')
	background-size 13px 13px
	background-position 7px center
	background-repeat no-repeat
	margin-bottom 11px

.decor
	position absolute
	pointer-events none
	background-repeat no-repeat
	z-index -1
	background-size contain

// Slider arrows
.slider-arrows
	display flex
	align-items center
	&__
		&arrow
			width 61px
			height 61px
			border-radius 9px
			background-color #222730
			transition 0.3s background-color, .3s opacity
			background-image url('../img/icon_arrow-next.svg')
			background-size 35%
			background-repeat no-repeat
			background-position center
			&:hover
				background-color lighten(#222730,5%)
			&.swiper-button-disabled
				opacity 0.5
				pointer-events none
		&prev
			margin-right 10px
			transform rotate(180deg)
// End Slider arrows

// Cheat status
.cheat-status
	padding 4px 7px
	font-size 14px
	font-weight 500
	color var(--color)
	display flex
	align-items center
	position relative
	svg
		width 12px
		height 12px
		margin-right 5px
		[fill]
			fill var(--color)
		[stroke]
			stroke var(--color)
	&::before
		content ''
		position absolute
		left 0
		right 0
		top 0
		bottom 0
		border-radius 4px
		background-color var(--color)
		opacity 0.09
	&_
		&undetected, &without-root
			--color #8AF59B
		&on-update, &with-root
			--color #F5C48A
		&detected
			--color #FF989F
		
// End Cheat status

// End Общие 

section
	position relative
	width 100%
	&:first-child
		padding-top var(--header-height)

// Header
.header
	font-size 16px
	position relative
	z-index 10
	height var(--header-height)
	position absolute
	left 0
	right 0
	top 0
	&__
		&container
			display flex
			align-items center
			height 100%
		&logo
			width 137px
			margin-right 94px
			display block
			will-change transform
			img
				object-fit contain
				object-position center
		&menu
			display flex
			align-items center
			list-style-type none
			margin-right auto
			font-family $fmm
			&__
				&item
					will-change transform
					&:not(:last-child)
						margin-right 55px
		&lang
			margin-right 40px
			.select
				&__
					&selected
						padding unset
						border-radius unset
						background-color unset
						padding-right 20px
						color #E9F1FF
						&::after
							right 0
							width 17px
							height 17px
							top calc(50% - 8.5px)
					&selected, &option
						display flex
						align-items center
						img
							width 19px
							height 13px
							object-fit cover
							object-position center
							border-radius 3px
							overflow hidden
							margin-right 10px
							flex-shrink 0
					&inner
						width calc(100% + 50px)
						right unset
						left -25px
		&search
			height 56px
			margin-right 20px
			position relative
			&-reset-btn
				width 17px
				height 17px
				right 30px
				top 31px
				position absolute
				background-image url('../img/icon_remove.svg')
				background-repeat no-repeat
				background-size contain
				background-position center
				opacity 0.3
				@media screen and (min-width 768px)
					display none
			&-btn
				width 20px
				height 20px
				background-image url('../img/icon_search.svg')
				background-repeat no-repeat
				background-position center
				background-size contain
				@media screen and (min-width 768px)
					display none
			
			&:not(._active)
				& ^[2]__
					&overlay, &inner
						opacity 0
						pointer-events none
			&__
				&scroll-container
					max-height 293px
				&input
					width 100%
					height 100%
					background-color #111720
					border-radius 32px
					padding 0 20px 0 54px
					background-image url('../img/icon_search.svg')
					background-repeat no-repeat
					background-size 20px 20px
					background-position 22px center
					font-family $fmm
					font-weight bold
					font-size 16px
				&overlay
					position fixed
					left 0
					top 0
					right 0
					bottom 0
					background rgba(#1B2330,.8)
					z-index -1
				&inner
					position absolute
					left 0
					right 0
					padding 20px 0
					background-color #111720
					border-radius 21px
					top calc(100% + 10px)
				&inner, &overlay
					transition 0.3s opacity
		&login
			height 56px
			padding 0 23px
			background-color #232B36
			font-weight 600
			font-family $fmm
			flex-shrink 0
		&hamburger
			width 31px
			height 31px
			display flex
			align-items center
			justify-content center
			margin-left 30px

			@media screen and (min-width 1440px)
				display none
			
			--color #F4F4F4
			--border-width 2px
			&._active
				span
					border-color transparent
					&::before
						top -2px
						transform rotate(45deg)
					&::after
						bottom 0
						transform rotate(-45deg)
			span
				border-top var(--border-width) solid var(--color)
				display block
				width 100%
				position relative
				width 22px
				&::before,&::after
					content ''
					position absolute
					left 0
					right 0
					border-top var(--border-width) solid var(--color)
					transition 0.3s transform, .3s top, .3s bottom
				&::before
					top -9px
				&::after
					bottom -7px
// End Header

[data-simplebar] .simplebar-scrollbar::before
	background #29313D
	left 3px
	right 3px

// Search item
.search-item
	display flex
	align-items center
	position relative
	transition 0.3s background-color
	padding 15px 0
	&:hover
		background-color #161C26
	&_
		&cheat
			& ^[0]__
				&image
					img
						width 53px
						height 53px
						border-radius 50%
	&__
		&link
			position absolute
			left 0
			right 0
			top 0
			bottom 0
		&image
			width 95px
			margin-right 5px
			display flex
			align-items center
			justify-content center
		&types, &status
			font-size 12px
			margin-bottom unset
		&name
			display block
			margin-top 7px
			font-size 16px
			font-weight 500

// End Search item

#card
	.container, .skill, .container__load-text, .container__btn, .telegram, .stats, .graph .bar, .platforms, .eclipse
		will-change transform
	.container
		width 510px
		height 628px
		border-radius 27px
		background linear-gradient(180deg, #18202C 0%, #141A25 100%)
		border 1px solid #212937
		position relative
		z-index 2
		display flex
		flex-direction column
		align-items center
		&__
			&color-btns
				position absolute
				left 25px
				top 25px
				display flex
				align-items center
				div
					width 12px
					height 12px
					border-radius 50%
					margin-right 8px
				.red
					background-color #FF5F57
				.yellow
					background-color #FFBD2E
				.green
					background-color #28CA42
			&caption
				margin 24px 0
				text-align center
				font-weight 500
				font-family $fmm
				font-size 30px
			&image
				width 381px
				display block
			&load-text
				border-radius 10px
				height 20px
				width 262px
				background-color #28303D
				& + .container__load-text
					width 196px
					margin-top 10px
			&btn
				padding 0 23px
				height 56px
				display inline-flex
				margin 37px auto 0
				background-color #232B36
				transition 0.3s background-color
				&:hover
					background-color lighten(#232B36, 5%)
	.skill
		padding 15px 26px 15px 50px
		border-radius 82px
		background-color #141C2A
		border 1px solid #212937
		position absolute
		top 130px
		left 0
		transform translateX(-50%)
		z-index 3
		text-transform uppercase
		font-size 21px
		font-weight 500
		font-family $fmm
		background-image url('../img/icon_rise.svg')
		background-size 14px 8px
		background-position 26px center
		background-repeat no-repeat
	.eclipse
		width 250px
		height 250px
		border-radius 50%
		background-color #262F3F
		filter blur(106.5px)
		position absolute
		top 120px
		left -125px
	.telegram
		padding 10px 72px 10px 10px
		border-radius 82px
		border 1px solid #212937
		background-color #141C2A
		position absolute
		top 88px
		right 0
		transform translateX(80%)
		font-family $fmm
		z-index 3
		display flex
		align-items center
		overflow hidden
		&:hover
			&::after
				opacity 1
		&::after
			content ''
			position absolute
			width 32px
			height 32px
			right 15px
			top 50%
			transform translateY(-50%)
			background-image url('../img/icon_go-arrow.svg')
			opacity 0.5
			transition 0.3s opacity
			background-size contain
			background-position center
		.link
			position absolute
			left 0
			right 0
			top 0
			bottom 0
			z-index 2
		.icon
			width 42px
			height 42px
			border-radius 50%
			background-color $accent
			margin-right 10px
			display flex
			align-items center
			justify-content center
			svg
				width 80%
				height 80%
				[fill]
					fill $w
				[stroke]
					stroke $w
				[opacity]
					opacity 1
		p
			font-size 19px
			font-weight 600
		span
			font-size 16px
			font-weight 500
			opacity 0.54
		div
			font-family inherit
	.platforms
		padding 30px 27px
		border-radius 27px
		background linear-gradient(180deg, #18202C 0%, #141A25 100%)
		border 1px solid #222938
		position absolute
		top 50%
		right 0
		transform translateX(50%)
		display flex
		flex-direction column
		align-items center
		z-index 3
		span
			width 28px
			height 28px
			opacity 0.5
			transition 0.3s opacity
			&:hover
				opacity 1
			&:not(:last-child)
				margin-bottom 30px
	.stats
		padding 25px
		border-radius 19px
		background linear-gradient(327.21deg, rgba(153, 224, 164, 0.11) 0%, rgba(20, 26, 37, 0) 99.23%), #141A25
		position absolute
		z-index 3
		bottom 89px
		left 0
		transform translateX(-50%)
		border 1px solid #212937
		span
			display block
		.caption
			font-size 20px
			font-weight 500
			font-family $fmm
		.subcaption
			margin-top 4px
			opacity 0.5
			font-size 13px
		.types
			margin 10px 0
		.graph
			display flex
			justify-content space-between
			--max-bar-height 90px
			.elem
				width 17px
				display flex
				flex-direction column
				justify-content flex-end
				text-align center
				.num
					margin-bottom 7px
					font-size 10px
					font-family $fmm
					color #6D7D99
					opacity 0.5
				.bar
					background-color #3E4B64
					border-radius 4px
				&:last-child
					.num
						opacity 1
						color #85E594
					.bar
						background-color #85E594

// Main
.main
	&-
		&section1
			background-image url('../img/main_section1_bg.png')
			background-repeat no-repeat
			background-position right center
			#card
				position absolute
				right 100px
				top 50%
				transform translateY(-50%)
			&__
				&inner
					width 800px
					max-width 60%
				&section-category
					& +  .section-caption
						margin-top 30px
				&section-caption
					font-size 71px
					margin-bottom 30px
				&section-subcaption
					width 570px
					max-width 100%
					font-family $fmm
				&btns
					display flex
					align-items center
					margin-top 80px
					.btn
						height 74px
						padding 0 32px
						&:not(:last-child)
							margin-right 18px
				&support
					display flex
					align-items center
					margin-top 70px
					font-family $fmm
					span
						margin-right 30px
						font-size 22px
						font-weight 500
						line-height 1.44
						opacity 0.3
					div
						width 28px
						height 28px
						display block
						opacity 0.3
						transition 0.3s opacity
						&:hover
							opacity 1
						&:not(:last-child)
							margin-right 15px
						img
							width 100%
							height 100%
							object-fit contain
							object-position center
// End Main

// Section 2
.section2
	position relative
	margin 130px 0 170px
	@media screen and (min-width 768px)
		.slider-arrows
			display none
	&::after
		content ''
		position absolute
		width 250px
		height 250px
		background-color rgba(#262F3F, .4)
		filter blur(106.5px)
		right -125px
		top 0
		pointer-events none
	&__
		&container
			display flex
			flex-direction column
			align-items center
		&slider
			margin-top 70px
			width 100%
			overflow visible !important
		&block-container
			z-index 2
			position relative
			&.swiper-wrapper
				@media screen and (min-width 768px)
					display grid
					grid-template-columns repeat(4,1fr)
					gap	29px
		&block
			background-color #171D28
			border-radius 12px
			align-items center
			flex-direction column
			text-align center
			padding 70px 34px 45px
			font-family $fmm
			will-change transform
			&.swiper-slide
				display flex
				@media screen and (min-width 768px)
					width unset
					height unset
					display flex
			&__
				&icon
					width 55px
					height 55px
					background-color $accent
					border-radius 50%
					display flex
					align-items center
					justify-content center
					img
						max-width 60%
						max-height 60%
				&caption
					margin 35px 0 10px
					font-size 26px
					font-weight 600
				&text
					font-size 18px
					font-weight 500
					opacity 0.5
// End Section 2

.main
	.catalog
		position relative
		background linear-gradient(180deg, rgba(255, 255, 255, 0.01) 47.15%, rgba(255, 255, 255, 0) 84.07%) 
		padding-top 110px
		&::before
			content ''
			position absolute
			left 0
			right 0
			top 0
			bottom 0
			background-image url('../img/catalog_bg.png')
			background-repeat no-repeat
			background-position top right
			pointer-events none

// Catalog
.catalog
	margin 130px 0
	.content
		position relative
		z-index 2
	&__
		&cards-container
			display grid
			grid-template-columns repeat(4,1fr)
			gap 20px
			margin-top 110px
		&show-more
			margin 100px auto 0
			border-radius 100px
			background-color #272F3C
			padding 24px 38px
			font-size 16px
		&platform
			min-width 270px
// End Catalog

// Card
.card
	height 400px
	border-radius 12px
	background-color #171D28
	padding 40px
	position relative
	padding-top calc(var(--card-image-height) + 10px)
	transition 0.3s background-color
	overflow hidden

	--card-image-height 242px
	&:hover
		background-color lighten(#171D28, 3%)
	&__
		&link
			position absolute
			left 0
			right 0
			top 0
			bottom 0
		&img
			pointer-events none
			position absolute
			top 0
			height var(--card-image-height)
			left -20px
			right -20px
			display flex
			align-items center
			justify-content center
			img
				width 100%
				height 100%
				object-fit contain
				object-position center
		&name-container
			display flex
			align-items center
			justify-content space-between
		&name
			font-size 24px
			font-weight 500
			line-height 1.44
			
			text-overflow ellipsis
			display -webkit-box
			overflow hidden
			max-height 2.88em
			-webkit-line-clamp 2
			-webkit-box-orient vertical
		&btn
			width 42px
			height 42px
			border-radius 50%
			background-color #232B36
			background-image url('../img/icon_8.svg')
			background-repeat no-repeat
			background-size 16px
			background-position center
			margin-left 10px
			transition 0.3s background-color
			flex-shrink 0
			&:hover
				background-color lighten(#232B36,10%)
// End Card

// Game Cheats Container
.game-cheats
	&__
		&slider-arrow
			width 49px
			height 49px
		&slider-container
			&:not(:last-child)
				margin-bottom 170px
			&:first-child
				margin-top 40px
	&-
		&slider
			margin-top 56px

// End Game Cheats Container

// Cheat card
.cheat-card
	padding 30px 35px
	border-radius 12px
	background-color #171D28
	.cheat-status
		position absolute
		right 22px
		top 22px
	&::before
		content ''
		position absolute
		left 0
		right 0
		top 0
		bottom 0
		background-color rgba(#171D28,.5)
		transition 0.3s opacity
		z-index 2
	&.swiper-slide
		max-width 291px !important
	&::before, &__btn
		opacity 0
	&:hover
		&::before, & ^[0]__btn
			opacity 1
	&__
		&btn
			position absolute
			left 50%
			top 50%
			transform translate(-50%,-50%)
			padding 14px 0
			border-radius 32px
			background-color #232B36
			font-size 16px
			font-weight 500
			line-height 1.4
			width calc(100% - 70px)
			text-align center
			transition 0.3s background-color, .3s opacity
			z-index 3
			&:hover
				background-color lighten(#232B36, 5%)
		&logo
			width 53px
			height 53px
			border-radius 50%
			display flex
			align-items center
			justify-content center
		&name
			margin 20px 0 10px
			font-size 26px
			font-weight 600
			line-height 1.44
			font-family $fmm
		&list
			list-style-type none
			li
				font-size 18px
				font-weight 500
				line-height 1.4
				opacity 0.5
				position relative
				padding-left 13px
				font-family $fmm
				&::before
					content ''
					position absolute
					left 0
					top 50%
					transform translateY(-50%)
					border 2px solid $w
					border-radius 50%
